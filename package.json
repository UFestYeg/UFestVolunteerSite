{
    "name": "volunteer-frontend",
    "version": "0.1.0",
    "private": true,
    "type": "commonjs",
    "dependencies": {
        "@emotion/react": "11.14.0",
        "@emotion/styled": "11.14.0",
        "@mui/icons-material": "5.18.0",
        "@mui/material": "5.18.0",
        "@mui/x-date-pickers": "7.29.4",
        "@testing-library/dom": "10.4.0",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.1",
        "@types/chroma-js": "3.1.2",
        "@types/date-arithmetic": "4.1.4",
        "@types/node": "25.9.1",
        "@types/react": "18.3.29",
        "@types/react-big-calendar": "1.16.2",
        "@types/react-dom": "18.3.7",
        "axios": "1.16.1",
        "chroma-js": "3.2.0",
        "clsx": "2.1.1",
        "date-arithmetic": "^4.1.0",
        "date-fns": "3.6.0",
        "distinct-colors": "^3.0.0",
        "formik": "2.4.9",
        "moment": "2.30.1",
        "moment-range": "^4.0.2",
        "notistack": "3.0.2",
        "react": "18.3.1",
        "react-big-calendar": "1.19.2",
        "react-cookie": "8.1.2",
        "react-dom": "18.3.1",
        "react-redux": "9.3.0",
        "react-router-dom": "7.15.1",
        "redux": "5.0.1",
        "redux-persist": "6.0.0",
        "redux-thunk": "3.1.0",
        "tss-react": "^4.9.21",
        "typescript": "5.9.3",
        "yup": "1.7.1"
    },
    "scripts": {
        "start": "vite",
        "dev": "vite",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "preview": "vite preview",
        "serve": "vite preview",
        "clean": "npm-run-all clean:*",
        "clean:build": "rimraf build/",
        "clean:node": "rimraf node_modules/",
        "check": "prettier --config .prettierrc.yaml --check \"src/**/*.{css,ts,tsx}\"",
        "lint": "eslint src --ext .ts,.tsx",
        "format": "prettier --config .prettierrc.yaml --write \"src/**/*.{css,ts,tsx}\"",
        "test": "vitest",
        "test:run": "vitest run"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@vitejs/plugin-react": "6.0.2",
        "@vitest/coverage-v8": "4.1.7",
        "eslint": "9.39.4",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "jsdom": "29.1.1",
        "npm-run-all": "^4.1.5",
        "prettier": "3.8.3",
        "rimraf": "^3.0.2",
        "typescript-eslint": "8.59.4",
        "vite": "8.0.14",
        "vitest": "^4.1.7"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
